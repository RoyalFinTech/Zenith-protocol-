NODE_ENV=development
PORT=8787
DATABASE_URL=postgresql://<database-role>:<database-password>@<database-host>:5432/<database-name>?sslmode=require
JWT_SECRET=
APP_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:8787
CHAIN_ID=56
CHAIN_NAME=BNB Smart Chain
NATIVE_CURRENCY=BNB
PRIMARY_ASSET=USDT
WALLETCONNECT_PROJECT_ID=
WALLETCONNECT_METADATA_NAME=Zenit Protocol
WALLETCONNECT_METADATA_DESCRIPTION=Decentralized Wealth Network
WALLETCONNECT_METADATA_URL=http://localhost:5173
WALLETCONNECT_METADATA_ICON=https://example.com/zenit-icon.png
SESSION_TTL_MINUTES=10080
NONCE_TTL_MINUTES=10
VAPID_SUBJECT=mailto:notifications@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CORS_ORIGINS=http://localhost:5173
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
USDT_CONTRACT_ADDRESS=0x55d398326f99059ff775485246999027b3197955
PAYMENT_RECEIVER_ADDRESS=
PAYMENT_CONFIRMATIONS=2

# Email provider: keep "resend" for the existing integration, or select "mailersend" for MailerSend.
EMAIL_PROVIDER=resend

RESEND_API_KEY=
RESEND_FROM=

# MailerSend transport: "api" uses an API token; "smtp" uses an SMTP relay user.
MAILERSEND_TRANSPORT=api
MAILERSEND_API_KEY=
MAILERSEND_FROM=
MAILERSEND_FROM_NAME=ZENIT Protocol

# MailerSend SMTP relay (TLS / STARTTLS).
MAILERSEND_SMTP_HOST=smtp.mailersend.net
MAILERSEND_SMTP_PORT=587
MAILERSEND_SMTP_USER=
MAILERSEND_SMTP_PASSWORD=


# MailerSend WhatsApp (uses MAILERSEND_API_KEY with the whatsapp_full scope).
# WhatsApp sender is the connected WhatsApp Business sender identifier (phone number in E.164 format or MailerSend sender ID).
MAILERSEND_WHATSAPP_FROM=
# Approved template with exactly one body variable containing the 6-digit reset code.
MAILERSEND_WHATSAPP_PIN_RESET_TEMPLATE_ID=
# Approved template with two body variables: title and message for important ZENIT updates.
MAILERSEND_WHATSAPP_UPDATE_TEMPLATE_ID=
