WALLETCONNECT_METADATA_URL=http://localhost:5173
WALLETCONNECT_METADATA_ICON=https://example.com/zenit-icon.png
SESSION_TTL_MINUTES=10080
NONCE_TTL_MINUTES=10
VAPID_SUBJECT=mailto:notifications@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
