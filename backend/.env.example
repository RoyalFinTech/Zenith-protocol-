API_PUBLIC_URL=http://localhost:8787
CHAIN_ID=56
CHAIN_NAME=BNB Smart Chain
NATIVE_CURRENCY=BNB
PRIMARY_ASSET=USDT
WALLETCONNECT_PROJECT_ID=
WALLETCONNECT_METADATA_NAME=Zenit Protocol
