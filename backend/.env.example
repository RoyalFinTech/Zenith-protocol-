# Email provider: keep "resend" for the existing integration, or select "mailersend" for the free trial-domain path.
EMAIL_PROVIDER=resend

RESEND_API_KEY=
RESEND_FROM=

# MailerSend: use the sender address from MailerSend's free trial domain.
# The registration recipient can still be a normal mailbox such as Gmail.
MAILERSEND_API_KEY=
MAILERSEND_FROM=
MAILERSEND_FROM_NAME=ZENIT Protocol
